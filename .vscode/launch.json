    {
        "version": "0.2.0",
        "configurations": [
            {
                "name": "3. Serveur PHP Interne + Xdebug (Sans Apache)",
                "type": "php",
                "request": "launch",
                "runtimeExecutable": "C:\\wamp\\bin\\php\\php8.2.0\\php.exe",
                "runtimeArgs": [
                    "-dxdebug.mode=debug",
                    "-dxdebug.start_with_request=yes",
                    "-dxdebug.client_host=127.0.0.1",
                    "-dxdebug.client_port=9090",
                    "-S",
                    "127.0.0.1:8000",
                    "-t",
                    "${workspaceFolder}\\public"
                ],
                "port": 9090,
                "hostname": "127.0.0.1",
                "log": true
            }
        ]
    }